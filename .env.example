# Log API
LOG_API_BASE_URL=https://bqapi.cleartripcorp.me/bqAPI
LOG_API_TOKEN=
LOG_API_USER=

# Gmail
GMAIL_LABEL=
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_POLL_INTERVAL_SECONDS=60

# Repo clones (agent's own, not your dev checkouts)
REPO_CLONE_BASE=~/.oncall_rca/repos
REPO_SUPPLY_CORE_NEW_BRANCH=
REPO_AIR_SMS_BRANCH=
REPO_AIR_SMS_NEW_BRANCH=

# Model
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# Budgets
INVESTIGATOR_MAX_ITERATIONS=10
TOKENS_PER_STAGE_LIMIT=50000
WALL_CLOCK_PER_RUN_SECONDS=300

# Output paths
OUTPUT_RCA_DIR=rca_reports
OUTPUT_CACHE_DIR=cache
